{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/rooms",
      "destination": "/rooms.html"
    },
    {
      "source": "/stay-with-us",
      "destination": "/rooms.html"
    },
    {
      "source": "/amenities",
      "destination": "/amenities.html"
    },
    {
      "source": "/shared-spaces",
      "destination": "/amenities.html"
    },
    {
      "source": "/gallery",
      "destination": "/gallery.html"
    },
    {
      "source": "/our-home",
      "destination": "/gallery.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/join-the-family",
      "destination": "/contact.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/plan-your-stay",
      "destination": "/pricing.html"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/rooms.html",
      "destination": "/rooms",
      "permanent": false
    },
    {
      "source": "/amenities.html",
      "destination": "/amenities",
      "permanent": false
    },
    {
      "source": "/gallery.html",
      "destination": "/gallery",
      "permanent": false
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": false
    },
    {
      "source": "/pricing.html",
      "destination": "/pricing",
      "permanent": false
    }
  ]
}
