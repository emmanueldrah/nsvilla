# Copy this file to .env and fill in the values.
# Vercel: set these in Project → Settings → Environment Variables instead.

# Required — the single admin password for the /admin portal.
ADMIN_PASSWORD=change-me

# Vercel KV (add a KV database in your Vercel project; Vercel fills these in automatically).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional — only needed if you want to upload flyer images (Vercel Blob).
BLOB_READ_WRITE_TOKEN=